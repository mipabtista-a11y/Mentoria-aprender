# Copia este arquivo como .env.local (local) e cadastra as mesmas
# variaveis no painel do Vercel (Settings > Environment Variables).

# SUPABASE
REACT_APP_SUPABASE_URL=https://xxxxx.supabase.co
# O Supabase renomeou "anon key" para "Publishable key" (sb_publishable_...).
# E a mesma coisa, funciona igual -- cola o valor dela aqui:
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxx

# NOTA: A cobranca da assinatura (Stripe) ainda nao esta conectada
# dentro do app -- veja o GUIA_DEPLOY.md para o que falta nessa parte.
